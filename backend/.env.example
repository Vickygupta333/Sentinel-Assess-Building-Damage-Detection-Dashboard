# Copy to .env and adjust, or export these directly in your shell / container.

# "heuristic" (default, no ML framework needed) or "cnn" (real TwinTowerCNN,
# requires torch + torchvision and a trained checkpoint).
DAMAGE_MODEL=heuristic

# Required only when DAMAGE_MODEL=cnn — path to a checkpoint produced by
# train.py (see README.md section 3).
MODEL_WEIGHTS=
